# Builds the Windows demo folder and zip from a release build. Run through the package_demo target:
#   cmake --build --preset release --target package_demo
# Output: <build>/dist/Afterglow-Imjin-1593-demo-<version>-win64/ and the .zip beside it. Nothing is uploaded.
foreach(required SOURCE_DIR BINARY_DIR EXECUTABLE VERSION)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "PackageDemo.cmake needs -D${required}=...")
    endif()
endforeach()
if(DEV_TOOLS)
    message(FATAL_ERROR "the demo must come from a build with TQ_DEV_TOOLS=OFF (use the release preset)")
endif()

set(name "Afterglow-Imjin-1593-demo-${VERSION}-win64")
set(out "${BINARY_DIR}/dist")
set(stage "${out}/${name}")
set(deps "${BINARY_DIR}/_deps")

# The executable must not carry the dev tools or need the MSVC runtime DLLs.
execute_process(COMMAND "${CMAKE_COMMAND}" -DBINARY=${EXECUTABLE} -P "${CMAKE_CURRENT_LIST_DIR}/CheckNoImGui.cmake"
                RESULT_VARIABLE imgui_result)
if(NOT imgui_result EQUAL 0)
    message(FATAL_ERROR "the executable contains ImGui")
endif()
find_program(DUMPBIN dumpbin)
if(DUMPBIN)
    execute_process(COMMAND "${DUMPBIN}" /nologo /dependents "${EXECUTABLE}" OUTPUT_VARIABLE dependents
                    RESULT_VARIABLE dumpbin_result)
    if(NOT dumpbin_result EQUAL 0)
        message(FATAL_ERROR "dumpbin failed on ${EXECUTABLE}")
    endif()
    string(REGEX MATCHALL "[A-Za-z0-9_.-]+\\.[dD][lL][lL]" dlls "${dependents}")
    list(REMOVE_DUPLICATES dlls)
    foreach(dll IN LISTS dlls)
        string(TOLOWER "${dll}" lower)
        if(lower MATCHES "^(msvcp|vcruntime|ucrtbase|api-ms-win-crt|concrt|vcomp|sfml|freetype|openal)")
            message(FATAL_ERROR "${EXECUTABLE} depends on ${dll}; build with the release preset (static runtime)")
        endif()
    endforeach()
    list(JOIN dlls ", " dll_list)
    message(STATUS "tieqi.exe depends on: ${dll_list}")
else()
    message(WARNING "dumpbin not found; run it from a VS developer prompt to check the DLL dependencies")
endif()

file(REMOVE_RECURSE "${stage}")
file(REMOVE "${out}/${name}.zip")
file(MAKE_DIRECTORY "${stage}")
file(COPY "${EXECUTABLE}" DESTINATION "${stage}")
file(COPY "${SOURCE_DIR}/data" DESTINATION "${stage}" PATTERN ".gitkeep" EXCLUDE)
file(COPY "${SOURCE_DIR}/assets" DESTINATION "${stage}" PATTERN ".gitkeep" EXCLUDE)
file(COPY "${SOURCE_DIR}/assets/AI_ASSETS.md" DESTINATION "${stage}")
configure_file("${SOURCE_DIR}/docs/demo/README.txt" "${stage}/README.txt" @ONLY NEWLINE_STYLE WIN32)

# Versions come from the declarations that fetched the sources, so the notices match what was linked.
function(fetched_tag file target out_var)
    file(READ "${file}" text)
    string(REGEX MATCH "FetchContent_Declare\\(${target}[^)]*GIT_TAG[ \t]+([^ \t\r\n)]+)" found "${text}")
    if(NOT found)
        message(FATAL_ERROR "no GIT_TAG for ${target} in ${file}")
    endif()
    set(${out_var} "${CMAKE_MATCH_1}" PARENT_SCOPE)
endfunction()

function(project_version file out_var)
    file(READ "${file}" text)
    string(REGEX MATCH "project\\([A-Za-z_]+[^)]*VERSION[ \t]+([0-9.]+)" found "${text}")
    if(NOT found)
        message(FATAL_ERROR "no project VERSION in ${file}")
    endif()
    set(${out_var} "${CMAKE_MATCH_1}" PARENT_SCOPE)
endfunction()

set(audio_cmake "${deps}/sfml-src/src/SFML/Audio/CMakeLists.txt")
set(graphics_cmake "${deps}/sfml-src/src/SFML/Graphics/CMakeLists.txt")
project_version("${deps}/sfml-src/CMakeLists.txt" sfml_version)
project_version("${deps}/json-src/CMakeLists.txt" json_version)
fetched_tag("${graphics_cmake}" Freetype freetype_version)
fetched_tag("${graphics_cmake}" HarfBuzz harfbuzz_version)
fetched_tag("${graphics_cmake}" SheenBidi sheenbidi_version)
fetched_tag("${audio_cmake}" ogg ogg_version)
fetched_tag("${audio_cmake}" vorbis vorbis_version)
fetched_tag("${audio_cmake}" flac flac_version)
set(miniaudio_header "${deps}/sfml-src/extlibs/headers/miniaudio/miniaudio.h")
file(STRINGS "${miniaudio_header}" miniaudio_lines REGEX "^#define MA_VERSION_(MAJOR|MINOR|REVISION)[ \t]+[0-9]+")
set(miniaudio_parts "")
foreach(line IN LISTS miniaudio_lines)
    string(REGEX REPLACE ".*[ \t]([0-9]+)$" "\\1" part "${line}")
    list(APPEND miniaudio_parts "${part}")
endforeach()
list(JOIN miniaudio_parts "." miniaudio_version)
file(READ "${miniaudio_header}" miniaudio_text)
string(FIND "${miniaudio_text}" "This software is available as a choice of the following licenses" miniaudio_at REVERSE)
string(SUBSTRING "${miniaudio_text}" ${miniaudio_at} -1 miniaudio_license)
string(REGEX REPLACE "\\*/[ \t\r\n]*$" "" miniaudio_license "${miniaudio_license}")

set(rule "================================================================================")
set(notices "Afterglow: Imjin 1593 demo ${VERSION} - third-party notices

tieqi.exe is statically linked with the libraries below. Each section gives the library, the version that was
built, and its license text as shipped with that version.

Portions of this software are copyright (C) The FreeType Project (www.freetype.org). All rights reserved.
FreeType is used under the FreeType License (FTL).

Fonts in assets/fonts are under the SIL Open Font License; their license files are in that folder.
")
function(add_notice title version)
    set(body "")
    foreach(file IN LISTS ARGN)
        if(NOT EXISTS "${file}")
            message(FATAL_ERROR "license file missing: ${file}")
        endif()
        file(READ "${file}" text)
        string(APPEND body "${text}\n")
    endforeach()
    set(notices "${notices}\n${rule}\n${title} ${version}\n${rule}\n\n${body}" PARENT_SCOPE)
endfunction()
add_notice("SFML" "${sfml_version}" "${deps}/sfml-src/license.md")
add_notice("FreeType" "${freetype_version}" "${deps}/freetype-src/LICENSE.TXT" "${deps}/freetype-src/docs/FTL.TXT")
add_notice("HarfBuzz" "${harfbuzz_version}" "${deps}/harfbuzz-src/COPYING")
add_notice("SheenBidi" "${sheenbidi_version}" "${deps}/sheenbidi-src/LICENSE")
add_notice("libogg" "${ogg_version}" "${deps}/ogg-src/COPYING")
add_notice("libvorbis" "${vorbis_version}" "${deps}/vorbis-src/COPYING")
add_notice("libFLAC" "${flac_version}" "${deps}/flac-src/COPYING.Xiph")
set(miniaudio_file "${out}/miniaudio-license.txt")
file(WRITE "${miniaudio_file}" "${miniaudio_license}")
add_notice("miniaudio" "${miniaudio_version}" "${miniaudio_file}")
file(REMOVE "${miniaudio_file}")
add_notice("nlohmann/json" "${json_version}" "${deps}/json-src/LICENSE.MIT")
file(WRITE "${stage}/THIRD_PARTY_NOTICES.txt" "${notices}")

execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${name}.zip" --format=zip "${name}" WORKING_DIRECTORY "${out}"
                RESULT_VARIABLE zip_result)
if(NOT zip_result EQUAL 0)
    message(FATAL_ERROR "could not write ${out}/${name}.zip")
endif()
message(STATUS "demo package: ${out}/${name}.zip")
