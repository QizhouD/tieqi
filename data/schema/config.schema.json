{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "config.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "time_scale", "player_speeds", "default_speed", "max_ticks_per_frame", "language", "reduced_motion", "sound"],
  "properties": {
    "schema": { "const": 1 },
    "time_scale": { "type": "number", "exclusiveMinimum": 0 },
    "player_speeds": { "type": "array", "minItems": 1, "items": { "type": "number", "exclusiveMinimum": 0 } },
    "default_speed": { "type": "number", "exclusiveMinimum": 0 },
    "max_ticks_per_frame": { "type": "integer", "exclusiveMinimum": 0 },
    "language": { "enum": ["zh-Hant", "en", "ko"] },
    "reduced_motion": { "type": "boolean" },
    "sound": { "type": "boolean" }
  }
}
