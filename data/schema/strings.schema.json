{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strings.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "language", "fonts", "strings"],
  "properties": {
    "schema": { "const": 1 },
    "language": { "type": "string", "minLength": 1 },
    "fonts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["body", "brush"],
      "properties": {
        "body": { "type": "string" },
        "brush": { "type": "string" }
      }
    },
    "strings": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  }
}
